-- ===== ฟังก์ชัน XOR =====
local function bxor(a, b)
  local r, p = 0, 1
  while a > 0 or b > 0 do
    local abit, bbit = a % 2, b % 2
    if abit ~= bbit then r = r + p end
    a = math.floor(a / 2)
    b = math.floor(b / 2)
    p = p * 2
  end
  return r
end

local function xor_decode(tbl, key)
  local out, n = {}, 1
  for i=1,#tbl do
    out[i] = bxor(tbl[i], key:byte(n))
    n = n + 1
    if n > #key then n = 1 end
  end
  local s = {}
  for i=1,#out do s[i] = string.char(out[i]) end
  return table.concat(s)
end

